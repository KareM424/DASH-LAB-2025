#include <cuda_runtime.h>
#include <stdio.h>
#include <stdlib.h>
#define N 1024
#define size 1024 * 1024
// CUDA kernel for matrix multiplication
__global__ void matrixMulKernel(float *A, float *B, float *C, int M, int N,
                                int K) {
  int row = blockIdx.y * blockDim.y + threadIdx.y; // Row index of C
  int col = blockIdx.x * blockDim.x + threadIdx.x; // Col index of C

  if (row < M && col < N) {
    float sum = 0.0f;
    for (int k = 0; k < K; ++k) {
      sum += A[row * K + k] * B[k * N + col];
    }
    C[row * N + col] = sum;
  }
}

// Helper function to initialize matrices
void initializeMatrix(float *matrix, int rows, int cols) {
  for (int i = 0; i < rows * cols; i++) {
    matrix[i] = (float)(rand() % 10);
  }
}

// Helper function to print matrix
void printMatrix(float *matrix, int rows, int cols) {
  for (int i = 0; i < rows; i++) {
    for (int j = 0; j < cols; j++) {
      printf("%.2f ", matrix[i * cols + j]);
    }
    printf("\n");
  }
}

int main() {
  // Matrix dimensions: A(M x K), B(K x N), C(M x N)

  // Allocate host memory
  size_t size_A = size * sizeof(float);
  size_t size_B = size * sizeof(float);
  size_t size_C = size * sizeof(float);
  float *h_A = (float *)malloc(size_A);
  float *h_B = (float *)malloc(size_B);
  float *h_C = (float *)malloc(size_C);
  // Initialize matrices A and B with random values
  initializeMatrix(h_A, N, N);
  initializeMatrix(h_B, N, N);

  printf("Matrix A (%d x %d):\n", N, N);
  printMatrix(h_A, N, N);
  printf("\nMatrix B (%d x %d):\n", N, N);
  printMatrix(h_B, N, N);

  // Allocate device memory
  float *d_A, *d_B, *d_C;
  cudaMalloc(&d_A, size_A);
  cudaMalloc(&d_B, size_B);
  cudaMalloc(&d_C, size_C);

  // Copy data from host to device
  cudaMemcpy(d_A, h_A, size_A, cudaMemcpyHostToDevice);
  cudaMemcpy(d_B, h_B, size_B, cudaMemcpyHostToDevice);

  // Configure block and grid dimensions
  dim3 threadsPerBlock(16, 16);
  dim3 blocksPerGrid((N + threadsPerBlock.x - 1) / threadsPerBlock.x,
                     (N + threadsPerBlock.y - 1) / threadsPerBlock.y);

  // Launch kernel
  matrixMulKernel<<<blocksPerGrid, threadsPerBlock>>>(d_A, d_B, d_C, N, N, N);

  // Check for kernel launch errors
  cudaError_t err = cudaGetLastError();
  if (err != cudaSuccess) {
    printf("CUDA kernel launch error: %s\n", cudaGetErrorString(err));
    return -1;
  }

  // Wait for GPU to finish
  cudaDeviceSynchronize();

  // Copy result back to host
  cudaMemcpy(h_C, d_C, size_C, cudaMemcpyDeviceToHost);

  // Print result
  printf("\nMatrix C = A x B (%d x %d):\n", N, N);
  printMatrix(h_C, N, N);

  // Free device memory
  cudaFree(d_A);
  cudaFree(d_B);
  cudaFree(d_C);

  // Free host memory
  free(h_A);
  free(h_B);
  free(h_C);

  return 0;
}
